<svg width="800" height="500" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="800" height="500" fill="#f5f5f5"/>
  
  <!-- Login Box -->
  <rect x="250" y="100" width="300" height="300" fill="white" stroke="#ddd" stroke-width="2" rx="10"/>
  
  <!-- Title -->
  <text x="400" y="150" font-family="Arial, sans-serif" font-size="24" font-weight="bold" text-anchor="middle" fill="#333">勤怠管理システム</text>
  
  <!-- Username Label -->
  <text x="270" y="200" font-family="Arial, sans-serif" font-size="14" fill="#666">ユーザー名</text>
  
  <!-- Username Input -->
  <rect x="270" y="210" width="260" height="35" fill="white" stroke="#ccc" stroke-width="1" rx="5"/>
  <text x="280" y="232" font-family="Arial, sans-serif" font-size="14" fill="#999">username</text>
  
  <!-- Password Label -->
  <text x="270" y="270" font-family="Arial, sans-serif" font-size="14" fill="#666">パスワード</text>
  
  <!-- Password Input -->
  <rect x="270" y="280" width="260" height="35" fill="white" stroke="#ccc" stroke-width="1" rx="5"/>
  <text x="280" y="302" font-family="Arial, sans-serif" font-size="14" fill="#999">••••••••</text>
  
  <!-- Login Button -->
  <rect x="270" y="340" width="260" height="40" fill="#007bff" stroke="none" rx="5"/>
  <text x="400" y="367" font-family="Arial, sans-serif" font-size="16" font-weight="bold" text-anchor="middle" fill="white">ログイン</text>
</svg>
